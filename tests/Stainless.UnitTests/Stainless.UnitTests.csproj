<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>stainless-unit-tests</AssemblyName>
    <RootNamespace>Stainless.UnitTests</RootNamespace>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- Every core binds at once, and the compiler allocates as it goes: the
         workstation collector stops them all for each collection. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="3.1.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
  </ItemGroup>

  <!-- clang's dump of a header holding one of each shape the bindings generator reads. -->
  <ItemGroup>
    <None Include="Bindgen/fixture.*;Bindgen/objc.*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The end-to-end harness's case selection, so it can be asked as another host. -->
  <ItemGroup>
    <Compile Include="../Stainless.Tests/CaseSelection.cs" Link="Harness/CaseSelection.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Stainless.Compiler/Stainless.Compiler.csproj" />
    <ProjectReference Include="../../tools/Stainless.Bindgen/Stainless.Bindgen.csproj" />
  </ItemGroup>
</Project>
