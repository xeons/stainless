// What this case's program carries inside itself.
//
// Deliberately all text: a bitmap or an icon would be a binary file in the
// repository, and none of what is being tested here needs one. The bitmap path
// is exercised by the Forms samples instead.

#include "ids.h"

STRINGTABLE
BEGIN
    IDS_FIRST   "the first string"
    IDS_SECOND  "the second string"
END

// RCDATA is the type for arbitrary bytes. The trailing NUL is written out
// because a resource has no terminator of its own: it is exactly as long as
// what was put in it.
IDR_PAYLOAD RCDATA { "payload\0" }

// A resource named by a string rather than a number, and of a custom type,
// which is the other half of what a resource name may be.
GREETING TEXTBLOB { "hello\0" }

// ------------------------------------------------------------------ version
//
// RT_VERSION is the one resource type with no `Load...` call of its own: it is
// a small tree rather than a value, read with `VerQueryValueW` out of
// `version.dll`. The four-part number below is what `Resources.Version()`
// unpacks, and the string block beside it is what a file's Properties dialog
// shows.
1 VERSIONINFO
FILEVERSION    1,2,3,4
PRODUCTVERSION 1,2,3,4
FILEOS         0x40004L
FILETYPE       0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Stainless resource case"
            VALUE "FileVersion",     "1.2.3.4"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
