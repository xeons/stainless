/// How many bytes `text` takes Huffman-coded.
internal nuint MeasureHpackHuffman(String text)
{
    nuint length = text.ByteLength();
    ulong bits = 0u;
    for (nuint i = 0u; i < length; i++)
        bits += (ulong)s_hpackHuffmanLengths[(nuint)text.GetByteAt(i)];
    return (nuint)((bits + 7u) / 8u);
}

/// Appends `text` Huffman-coded, padded with the most significant bits of
/// EOS.
internal void EncodeHpackHuffman(String text, Http2Buffer output)
{
    nuint length = text.ByteLength();
    ulong pending = 0u;
    uint pendingBits = 0u;
    for (nuint i = 0u; i < length; i++)
    {
        nuint symbol = (nuint)text.GetByteAt(i);
        uint codeLength = (uint)s_hpackHuffmanLengths[symbol];
        pending = (pending << codeLength) | (ulong)s_hpackHuffmanCodes[symbol];
        pendingBits += codeLength;
        while (pendingBits >= 8u)
        {
            pendingBits -= 8u;
            output.WriteByte((uint)((pending >> pendingBits) & 0xFFu));
        }
        pending &= (1u << pendingBits) - 1u;
    }
    if (pendingBits > 0u)
    {
        uint padding = 8u - pendingBits;
        output.WriteByte((uint)(((pending << padding) | ((1u << padding) - 1u)) & 0xFFu));
    }
}

/// Decodes `count` Huffman-coded bytes of `data` from `offset`. False when
/// the code holds EOS, or ends in padding longer than seven bits or other
/// than the start of EOS (RFC 7541 §5.2).
internal bool DecodeHpackHuffman(byte[] data, nuint offset, nuint count, out String text)
{
    text = "";
    if (count == 0u)
        return true;
    // The shortest code is five bits.
    var decoded = new byte[count * 8u / 5u + 1u];
    nuint written = 0u;
    nuint node = 0u;
    uint depth = 0u;
    bool allOnes = true;
    for (nuint i = 0u; i < count; i++)
    {
        uint octet = (uint)data[offset + i];
        for (int shift = 7; shift >= 0; shift--)
        {
            uint bit = (octet >> shift) & 1u;
            uint child = (uint)s_hpackHuffmanTree[node * 2u + (nuint)bit];
            if ((child & 0x8000u) != 0u)
            {
                uint symbol = child & 0x7FFFu;
                if (symbol == 256u)
                    return false;
                decoded[written] = (byte)symbol;
                written++;
                node = 0u;
                depth = 0u;
                allOnes = true;
            }
            else
            {
                node = (nuint)child;
                depth++;
                if (bit == 0u)
                    allOnes = false;
            }
        }
    }
    if (depth > 7u || !allOnes)
        return false;
    text = ConvertHttpBytesToText(decoded, 0u, written);
    return true;
}
