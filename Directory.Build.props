<Project>

  <!-- The style rules in .editorconfig are checked by the build, not only by an
       IDE. The C# here already satisfies them, so turning this on costs nothing
       today and keeps it that way. docs/style.md is the prose version. -->
  <PropertyGroup>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- The major and minor version, and the one place either is written. The
       third part is the commit count; tools/Version.proj computes it. -->
  <PropertyGroup>
    <VersionPrefix>0.1</VersionPrefix>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

</Project>
