# .NET build output
bin/
obj/

# Stainless build output
*.exe
*.ll
*.o
*.obj
*.pdb
*.ilk

# Stainless library output
*.dll
*.lib
*.so
*.dylib

# Sample build output, including generated headers
samples/**/build/

# IDE build output
ide/build/
ide/slforms/build/

# The debug engine's build output
debug/build/

# What the IDE's fixture project builds when a test compiles it
ide/tests/fixture/build/

# Screenshots pulled back from the Linux test box
linux-shots/

# Where forms/screenshot.ps1 writes by default
shots/

# The io test case writes its scratch files here when run from the repo root.
stainless-io/
